<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Share_Open_Initiatives_With_Volunteers</fullName>
        <accessLevel>Read</accessLevel>
        <description>Lets logged-in volunteers see initiatives that are upcoming or in progress, so shifts can show the initiative name.</description>
        <label>Share Open Initiatives With Volunteers</label>
        <sharedTo>
            <allCustomerPortalUsers></allCustomerPortalUsers>
        </sharedTo>
        <booleanFilter>1 OR 2</booleanFilter>
        <criteriaItems>
            <field>Status</field>
            <operation>equals</operation>
            <value>Upcoming</value>
        </criteriaItems>
        <criteriaItems>
            <field>Status</field>
            <operation>equals</operation>
            <value>In Progress</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
